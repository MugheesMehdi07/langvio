# Langvio Environment Configuration Template
# Copy this file to .env and fill in your API key

# Qwen-VL over an OpenAI-compatible API (langvio's default backend).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: another OpenAI-compatible provider (DashScope, HF router, vLLM...)
# QWEN_API_KEY=your_api_key_here
# QWEN_API_BASE_URL=https://openrouter.ai/api/v1
# QWEN_API_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Optional: "auto" (default: API if a key is set above, else local weights),
# "api" or "local" (in-process weights, needs langvio[vlm])
# LANGVIO_BACKEND=auto

# Optional: LangSmith Configuration (for tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=langvio

# Optional: Performance Settings (local backend)
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Optional: Default Model Settings
LANGVIO_DEFAULT_LLM=qwen
LANGVIO_DEFAULT_VISION=qwen_vlm
